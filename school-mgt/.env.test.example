# Copy to `school-mgt/.env.test` and adjust for a local test PostgreSQL database.
# The e2e suite (npm run test:e2e) loads this file and uses it to boot the app.

# Database (test)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
DATABASE_NAME=school_management_test

# JWT
JWT_SECRET=school-mgt-test-jwt-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Google OAuth (test placeholders)
GOOGLE_CLIENT_ID=test-client-id
PROJECT_ID=test-project
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=test-client-secret
REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
JAVASCRIPT_ORIGIN=http://localhost:3000